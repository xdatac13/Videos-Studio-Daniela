{
  "name": "estudio-daniela",
  "version": "1.0.0",
  "description": "Estudio Daniela — editor de video con Claude para creadoras de contenido",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch server/index.js",
    "demo": "AI_MOCK=1 node --disable-warning=ExperimentalWarning server/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test",
    "reset-password": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/cli.js reset-password",
    "set-plan": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/cli.js set-plan",
    "make-admin": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/cli.js make-admin"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "express": "^5.3.0"
  }
}

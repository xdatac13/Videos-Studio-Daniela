# Copy to .env and fill in. Only ANTHROPIC_API_KEY is needed for the Claude features.

# --- Claude (https://console.anthropic.com → API keys) ---
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5     # default. A cheaper option: claude-sonnet-5-5
# CLAUDE_EFFORT=medium             # low | medium | high — how hard Claude thinks (and what it costs)
# AI_MOCK=1                        # demo answers, no key needed: try every screen for free

# --- Accounts ---
# ADMIN_EMAIL=you@example.com      # this account administers the studio (otherwise: the first account created)
# INVITE_CODE=choose-a-code        # if set, creating an account requires this code
# SIGNUP_MODE=closed               # open | invite | closed (closed: nobody after the first account)
# PLAN_FREE_CREDITS=40             # Claude credits per month on the free plan
# PLAN_PRO_CREDITS=600             # … on the Pro plan

# --- Transcription (optional): ElevenLabs Scribe → subtitles on highlights, cuts on word boundaries ---
# ELEVENLABS_API_KEY=
# ELEVENLABS_STT_MODEL=scribe_v1

# --- Payments (optional): a Stripe subscription that switches an account to Pro ---
# STRIPE_SECRET_KEY=sk_live_…
# STRIPE_PRICE_ID=price_…
# STRIPE_WEBHOOK_SECRET=whsec_…    # webhook endpoint: https://your-domain/api/billing/webhook
# APP_URL=https://your-domain      # used for the return links after payment

# --- Server ---
# PORT=3000
# DATA_DIR=./data                  # where the SQLite file lives: keep it on a persistent disk
